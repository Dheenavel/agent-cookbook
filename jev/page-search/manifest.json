{
  "manifest_version": 3,
  "name": "JEV Page Search",
  "version": "1.0.0",
  "description": "Semantic search on any webpage powered by JEV. Press Ctrl+Shift+F to search.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://api.typesafe.ai/*"
  ],
  "commands": {
    "toggle-search": {
      "suggested_key": {
        "default": "Ctrl+Shift+F",
        "mac": "Ctrl+Shift+F"
      },
      "description": "Toggle JEV page search overlay"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "JEV Page Search"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
